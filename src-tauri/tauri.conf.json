{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Software Center",
  "version": "0.1.1",
  "identifier": "digital.laux.software-center",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Software Center",
        "width": 920,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "opsi Software-on-Demand Client",
    "longDescription": "Software Center — freigegebene Software selbst installieren, aktualisieren und entfernen (opsi Software on Demand).",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
