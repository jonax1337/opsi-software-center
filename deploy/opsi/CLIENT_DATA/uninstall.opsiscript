; ----------------------------------------------------------------------
; Software Portal — uninstall
; ----------------------------------------------------------------------
[Actions]
requiredWinstVersion >= "4.12.4"
ScriptErrorMessages=off

DefVar $InstallDir$

Set $InstallDir$ = "%ProgramFiles64Dir%\Software Portal"

comment "--- laufende Instanzen beenden ---"
Killtask "Software Portal.exe"
Killtask "opsi-kiosk.exe"

comment "--- NSIS-Uninstaller ausfuehren ---"
if FileExists("$InstallDir$\uninstall.exe")
	Winbatch_uninstall
endif

comment "--- Reste entfernen (Startmenue-/Desktop-Links raeumt der NSIS-Uninstaller) ---"
Files_cleanup
Registry_remove_branding /64Bit

[Winbatch_uninstall]
"$InstallDir$\uninstall.exe" /S

[Files_cleanup]
delete -sf "$InstallDir$\"
delete -sf "%CommonAppDataDir%\opsi-kiosk\"

[Registry_remove_branding]
deletekey [HKEY_LOCAL_MACHINE\SOFTWARE\opsi-kiosk]
