; ----------------------------------------------------------------------
; Software Portal — setup
; Fast-Exit wenn die Soll-Version bereits installiert ist (enforce-tauglich,
; Check gegen Uninstall-Registry-DisplayVersion). Icons, Aktionen und Branding werden
; immer aktualisiert, damit geaenderte Produkt-Properties sofort greifen.
; Der Installer wird vor dem Start lokal kopiert (EXE direkt vom Depot-Share
; haengt in Session 0).
; ----------------------------------------------------------------------
[Actions]
requiredWinstVersion >= "4.12.4"
ScriptErrorMessages=off

DefVar $ProductVersion$
DefVar $InstalledVersion$
DefVar $DataDir$
DefVar $InstallDir$
DefVar $LocalSetup$
DefVar $LegacyInstallDir$
DefVar $ExitCode$
DefVar $CompanyName$
DefVar $SupportPhone$
DefVar $SupportEmail$
DefVar $SupportUrl$
DefVar $BrandColor$
DefVar $FeaturedProducts$
DefStringList $FeaturedList$

; Wird von deploy/build-opsi-package.ps1 aus package.json gesetzt — nicht von Hand aendern.
Set $ProductVersion$ = "0.3.0"
Set $DataDir$ = "%CommonAppDataDir%\opsi-kiosk"
Set $InstallDir$ = "%ProgramFiles64Dir%\Software Portal"
Set $LocalSetup$ = "%opsiTmpDir%\software-portal-setup.exe"
; Install folder of releases up to 0.3.0, which shipped as "Software Center".
Set $LegacyInstallDir$ = "%ProgramFiles64Dir%\Software Center"

Set $CompanyName$ = GetProductProperty("company_name", "")
Set $SupportPhone$ = GetProductProperty("support_phone", "")
Set $SupportEmail$ = GetProductProperty("support_email", "")
Set $SupportUrl$ = GetProductProperty("support_url", "")
Set $BrandColor$ = GetProductProperty("brand_color", "")
; Multi-value property -> comma-separated REG_SZ (the app splits it again).
Set $FeaturedList$ = GetProductPropertyList("featured_products", $FeaturedList$)
Set $FeaturedProducts$ = composeString($FeaturedList$, ",")

comment "--- Icons und Branding immer aktualisieren (auch bei Fast-Exit) ---"
DosInAnIcon_prepare_datadir
Registry_branding /64Bit

comment "--- Fast-Exit: Soll-Version bereits installiert? ---"
Set $InstalledVersion$ = GetRegistryStringValue64("[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Software Portal] DisplayVersion")
if $InstalledVersion$ = ""
	Set $InstalledVersion$ = GetRegistryStringValue32("[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Software Portal] DisplayVersion")
endif
if $InstalledVersion$ = $ProductVersion$
	comment "Software Portal " + $InstalledVersion$ + " bereits installiert -> Fast-Exit."
else
	comment "--- laufende Instanzen beenden ---"
	Killtask "Software Portal.exe"
	Killtask "opsi-kiosk.exe"

	comment "--- Vorgaenger 'Software Center' (alter Produktname) entfernen ---"
	Killtask "Software Center.exe"
	if FileExists("$LegacyInstallDir$\uninstall.exe")
		Winbatch_uninstall_legacy
	endif
	Files_remove_legacy
	Registry_remove_legacy_autostart /AllNtUserDats

	comment "--- Installer lokal kopieren (nie EXE vom Share starten) ---"
	Files_copy_setup

	comment "--- Installer ausfuehren ---"
	Winbatch_install
	Set $ExitCode$ = getLastExitCode
	if not ($ExitCode$ = "0")
		logError "NSIS-Setup beendete sich mit ExitCode " + $ExitCode$
		isFatalError
	endif

	comment "--- Desktop-Link entfernen (Startmenue-Eintrag bleibt) ---"
	LinkFolder_remove_desktop

	comment "--- Temp aufraeumen ---"
	Files_cleanup_tmp
endif

comment "--- Wartungsaktionen immer aktualisieren (auch bei Fast-Exit) ---"
DosInAnIcon_deploy_actions

; Recreated on every run, then locked down: only SYSTEM and Administrators may
; write (SIDs S-1-5-18, S-1-5-32-544), users only read (S-1-5-32-545) — by
; default users could create files under %ProgramData% and plant icons.
; Icons are optional (CLIENT_DATA\icons may be empty) — copy only if present.
[DosInAnIcon_prepare_datadir]
if exist "$DataDir$" rmdir /s /q "$DataDir$"
mkdir "$DataDir$\icons"
icacls "$DataDir$" /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F *S-1-5-32-545:(OI)(CI)RX /Q
if exist "%ScriptPath%\icons\*.*" xcopy /y /q "%ScriptPath%\icons\*.*" "$DataDir$\icons\"

; Maintenance scripts the app runs ("Aktionen Ihrer IT") go next to the exe,
; NOT to %ProgramData%: there any user may create the folder first and then own
; it, so an ACL set afterwards cannot be trusted. Under Program Files users
; can neither create nor change anything. Replaced on every run so scripts
; removed from the package disappear. Optional — CLIENT_DATA\actions may be empty.
[DosInAnIcon_deploy_actions]
if exist "$InstallDir$\actions" rmdir /s /q "$InstallDir$\actions"
if exist "%ScriptPath%\actions\actions.json" xcopy /y /q /i "%ScriptPath%\actions\*.*" "$InstallDir$\actions\"

; HKLM: standard users cannot write here, so the support contacts shown in
; the app always come from the admin.
[Registry_branding]
openkey [HKEY_LOCAL_MACHINE\SOFTWARE\opsi-kiosk\Branding]
set "company_name" = "$CompanyName$"
set "support_phone" = "$SupportPhone$"
set "support_email" = "$SupportEmail$"
set "support_url" = "$SupportUrl$"
set "brand_color" = "$BrandColor$"
set "featured_products" = "$FeaturedProducts$"

[Winbatch_install]
"$LocalSetup$" /S

[Winbatch_uninstall_legacy]
"$LegacyInstallDir$\uninstall.exe" /S

[Files_remove_legacy]
delete -sf "$LegacyInstallDir$\"

; The old build registered its autostart under the old product name in every
; user's HKCU Run key; the renamed app adds its own entry on first start.
[Registry_remove_legacy_autostart]
openkey [Software\Microsoft\Windows\CurrentVersion\Run]
deletevar "Software Center"

[Files_copy_setup]
copy "%ScriptPath%\files\software-portal-setup.exe" "%opsiTmpDir%\"

[Files_cleanup_tmp]
delete -f "$LocalSetup$"

[LinkFolder_remove_desktop]
set_basefolder common_desktopdirectory
set_subfolder ""
delete_element "Software Portal"
